# Experimental maximum aggregate-throughput profile (explicit quality trade).
# Not recommended for quality-first use. C64 is only validated for short/512;
# use C48 admission for 1,024-token generations. Validated at 450 W.
PROFILE_NAME=batch-max
POWER_LIMIT_W=450
GPU_INDEX=0
IMAGE=qwen38-27b-rtx4090:latest
BATCH_VALIDATED_IMAGE_ID=sha256:cf6e665e5aac53a7461b50576155e1dd3af15a886bf7e406be21e8e7ef706255
MODELS_DIR=./.artifacts/models
CACHE_DIR=./.artifacts/cache-batch-max
QUALITY_DATA_DIR=./.artifacts/quality-data
BENCH_RESULTS_DIR=./.artifacts/bench-results
PORT=18020
INT8_ACT=int8
INT8_LAYERS=.
KV=fp8
MAX_SEQS=64
MAX_LEN=150000
GPU_UTIL=0.95
PREFIX_CACHE=0
TOOLS=1
# 6.4 GiB: enough for the measured C64 resident set, with more transient
# headroom than the warm auto-sized 6.61 GiB pool.
EXTRA_ARGS=--kv-cache-memory=6871947673
