         hide_stream_metadata = not request.include_reasoning and self.parser is not None
@@ -1395,6 +1398,7 @@ class OpenAIServingResponses(OpenAIServing):
             if not delta_message:
                 continue
 
+            delta_message = processor.filter_parallel_tool_calls(delta_message)
             for dm in split_delta(
